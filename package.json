{
  "name": "weshcraft",
  "version": "0.1.0",
  "description": "Iterate on a FigCraft prototype over MCP and generate front-end and back-end specs that match it exactly, live in the browser, published to GitHub or GitLab.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "weshcraft": "bin/weshcraft.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/weshcraft.mjs serve",
    "test": "node --test test/weshcraft.test.mjs",
    "demo": "node -e \"const fs=require('fs');fs.mkdirSync('.weshcraft-demo/design',{recursive:true});if(!fs.existsSync('.weshcraft-demo/design/ridgeline-app.figcraft'))fs.copyFileSync('test/fixtures/ridgeline-app.figcraft','.weshcraft-demo/design/ridgeline-app.figcraft')\" && node bin/weshcraft.mjs serve --out .weshcraft-demo",
    "build:openchamber": "node openchamber/build.mjs",
    "test:openchamber": "node test/openchamber/all.mjs",
    "test:codegraph": "node test/codegraph.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "wesh-bundle",
    "opencode",
    "openchamber",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.1"
    },
    "contributes": {
      "panel": {
        "id": "weshcraft",
        "name": "WeshCraft",
        "icon": "openchamber/icon.svg",
        "entry": "openchamber/page/index.html"
      },
      "page": {
        "entry": "openchamber/page/index.html",
        "title": "WeshCraft"
      },
      "service": {
        "entry": "openchamber/service/main.js",
        "runtime": "host"
      },
      "tools": [
        {
          "match": "weshcraft_status",
          "name": "WeshCraft",
          "icon": "pulse-line",
          "title": "Status",
          "output": "json"
        },
        {
          "match": "weshcraft_check",
          "name": "WeshCraft",
          "icon": "shield-check-line",
          "title": "Parity check",
          "output": "json"
        },
        {
          "match": "weshcraft_read_spec",
          "name": "WeshCraft",
          "icon": "file-text-line",
          "title": "{input.path}",
          "output": "markdown"
        },
        {
          "match": "weshcraft_sync",
          "name": "WeshCraft",
          "icon": "git-branch-line",
          "title": "Sync",
          "subtitle": "{input.target}",
          "output": "json"
        },
        {
          "match": "weshcraft_open",
          "name": "WeshCraft",
          "icon": "external-link-line",
          "title": "Open WeshCraft",
          "output": "markdown"
        },
        {
          "match": "design_tree",
          "name": "WeshCraft design",
          "icon": "node-tree",
          "title": "Layers",
          "subtitle": "{input.root}",
          "output": "text"
        },
        {
          "match": "design_edit",
          "name": "WeshCraft design",
          "icon": "pencil-ruler-2-line",
          "title": "Edit design",
          "subtitle": "{input.label}",
          "output": "json"
        },
        {
          "match": "design_text",
          "name": "WeshCraft design",
          "icon": "text",
          "title": "Edit copy",
          "output": "json"
        },
        {
          "match": "design_api",
          "name": "WeshCraft design",
          "icon": "exchange-line",
          "title": "{input.method} {input.path}",
          "output": "json"
        },
        {
          "match": "design_bind",
          "name": "WeshCraft design",
          "icon": "database-2-line",
          "title": "Bind {input.entity}.{input.field}",
          "output": "json"
        },
        {
          "match": "design_link",
          "name": "WeshCraft design",
          "icon": "link",
          "title": "Prototype link",
          "output": "json"
        },
        {
          "match": "design_screen",
          "name": "WeshCraft design",
          "icon": "smartphone-line",
          "title": "New screen {input.name}",
          "output": "json"
        },
        {
          "match": "design_functions",
          "name": "WeshCraft functions",
          "icon": "organization-chart",
          "title": "Product functions",
          "subtitle": "{input.set.name}",
          "output": "json"
        },
        {
          "match": "design_*",
          "name": "WeshCraft design",
          "icon": "openchamber/icon.svg",
          "output": "auto"
        },
        {
          "match": "weshcraft_*",
          "name": "WeshCraft",
          "icon": "openchamber/icon.svg",
          "output": "auto"
        },
        {
          "match": "figcraft_*",
          "name": "FigCraft",
          "icon": "pen-nib-line",
          "output": "auto"
        }
      ]
    }
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.6.0",
    "esbuild": "^0.28.2"
  }
}
